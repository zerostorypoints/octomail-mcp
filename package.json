{
  "name": "@zerostorypoints/octomail-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Octomail: a local multi-account Gmail MCP server for using multiple Gmail accounts side by side.",
  "license": "Apache-2.0",
  "author": "Piotr Dziubecki <piotr@zerostorypoints.com>",
  "homepage": "https://github.com/zerostorypoints/octomail-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerostorypoints/octomail-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zerostorypoints/octomail-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "claude",
    "claude-code",
    "codex",
    "typescript"
  ],
  "bin": {
    "octomail": "./dist/server.js"
  },
  "scripts": {
    "auth": "tsx src/auth.ts",
    "doctor": "tsx src/doctor.ts",
    "setup": "tsx src/setup.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "dotenv": "^17.2.1",
    "google-auth-library": "9.15.1",
    "googleapis": "^144.0.0",
    "ical.js": "^2.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.2"
  }
}
